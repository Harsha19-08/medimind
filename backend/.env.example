# --- MongoDB ---
# Local: install MongoDB Community and leave this as-is.
# Cloud (free): create a free MongoDB Atlas cluster, paste its connection string here.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=medimind

# --- AI (bill/prescription reading) ---
AI_PROVIDER=openrouter

# OpenRouter (free) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# openrouter/free auto-picks a free model that supports image input, so you
# don't need to track which specific free vision model is live right now.
# Pin one instead if you want consistent behaviour, e.g.:
#   OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free
OPENROUTER_MODEL=openrouter/free

# Only used if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5

# --- Who the medicine is for (used in family-member SMS wording) ---
PATIENT_NAME=

# --- Recipients ---
REMINDERS_CSV_PATH=reminders.csv

TIMEZONE=Asia/Kolkata

# --- SMS Gateway for Android (Local Server mode) ---
SMS_PROVIDER=android_gateway
SMS_GATEWAY_URL=http://192.168.1.8:8080
SMS_GATEWAY_USERNAME=sms
SMS_GATEWAY_PASSWORD=

# --- CORS: the frontend origin(s) allowed to call this API ---
ALLOWED_ORIGINS=http://localhost:3000
